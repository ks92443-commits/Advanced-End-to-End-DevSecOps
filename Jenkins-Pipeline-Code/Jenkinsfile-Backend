pipeline {
    agent any
    tools {
        jdk 'jdk'
        nodejs 'nodejs'
    }
    environment {
        SCANNER_HOME          = tool 'sonar-scanner'
        AWS_DEFAULT_REGION    = 'us-east-1'
        AWS_ACCESS_KEY_ID     = credentials('AWS_ACCESS_KEY_ID')
        AWS_SECRET_ACCESS_KEY = credentials('AWS_SECRET_ACCESS_KEY')
        AWS_ACCOUNT_ID        = credentials('ACCOUNT_ID')
        ECR_REPO              = credentials('ECR_REPO2')
        REGISTRY              = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"
        REPOSITORY_URI        = "${REGISTRY}/${ECR_REPO}"
        IMAGE_TAG             = "${BUILD_NUMBER}"
    }
    stages {
        stage('Cleanup Workspace') {
            steps { cleanWs() }
        }
        stage('Checkout from Git') {
            steps {
                git branch: 'main',
                    credentialsId: 'GITHUB',
                    url: 'https://github.com/ks92443-commits/Advanced-End-to-End-DevSecOps.git'
            }
        }
        stage('SonarQube Analysis') {
            steps {
                dir('Application-Code/backend') {
                    withSonarQubeEnv('sonar-server') {
                        sh '$SCANNER_HOME/bin/sonar-scanner -Dsonar.projectKey=backend -Dsonar.projectName=backend -Dsonar.sources=. -Dsonar.exclusions=node_modules/**'
                    }
                }
            }
        }
        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: false
                }
            }
        }
        stage('Trivy File Scan') {
            steps {
                sh 'trivy fs --severity HIGH,CRITICAL Application-Code/backend > trivy-fs-backend.txt || true'
            }
        }
        stage('Docker Build') {
            steps {
                dir('Application-Code/backend') {
                    sh 'docker build -t ${ECR_REPO}:${IMAGE_TAG} .'
                }
            }
        }
        stage('Trivy Image Scan') {
            steps {
                sh 'trivy image --severity HIGH,CRITICAL ${ECR_REPO}:${IMAGE_TAG} > trivy-image-backend.txt || true'
            }
        }
        stage('Push to ECR') {
            steps {
                sh 'aws ecr get-login-password --region $AWS_DEFAULT_REGION | docker login --username AWS --password-stdin $REGISTRY'
                sh 'docker tag ${ECR_REPO}:${IMAGE_TAG} ${REPOSITORY_URI}:${IMAGE_TAG}'
                sh 'docker push ${REPOSITORY_URI}:${IMAGE_TAG}'
            }
        }
    }
    post {
        always {
            archiveArtifacts artifacts: 'trivy-*.txt', allowEmptyArchive: true
        }
    }
}
